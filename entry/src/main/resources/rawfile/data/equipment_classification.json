{
  "version": 2,
  "_comment": "装备分类规则。保持为标准 JSON",
  "schema": {
    "_comment": "匹配建议：先按 equipTypes/api_type[2]、iconIds/api_type[3] 判断，再应用 includeMasterIds/excludeMasterIds 和名称片段修正。",
    "equipTypes": "装备图鉴类型 api_mst_slotitem.api_type[2]",
    "iconIds": "装备图标类型 api_mst_slotitem.api_type[3]",
    "includeMasterIds": "强制纳入的装备 masterId/api_id，用于 api_type 无法精确表达的特殊装备",
    "excludeMasterIds": "强制排除的装备 masterId/api_id，用于覆盖误分类",
    "nameIncludesAny": "名称包含任一片段时匹配；游戏原始名称一般为日文",
    "nameExcludesAny": "名称包含任一片段时排除",
    "minAsw": "可选，对潜值下限 api_tais",
    "groupsAny": "可选，组合分组：任一子分组匹配即匹配"
  },
  "slotItemEquipTypes": {
    "_comment": "这里只列当前对潜/面板逻辑常用类型；完整枚举见 domain/models/struct/slotitem.ts",
